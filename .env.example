# Copy to .env and fill in. .env is gitignored; this file is committed and must never hold real secrets.

# Supabase (Project Settings -> API Keys)
SUPABASE_URL=https://zvexcxpweirsjgeinrtu.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Dashboard -> Connect -> "Session pooler" URI (IPv4-friendly), with your DB password filled in
SUPABASE_DB_URL=

# Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Freshservice (Profile settings -> API key; domain like yourcompany.freshservice.com)
FRESHSERVICE_DOMAIN=
FRESHSERVICE_API_KEY=

# Cluster access
PROMETHEUS_URL=http://localhost:9090
KUBECONFIG_PATH=./sentinelops-agent.kubeconfig
