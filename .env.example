# Copy to .env and fill in. .env is gitignored; this file is committed and must never hold real secrets.
#
# Only the first three blocks are required. Freshservice, Vobiz, Sarvam and ElevenLabs each
# degrade to "not configured" on the health endpoint, and the core loop still completes.

# ── Required ────────────────────────────────────────────────────────────────

# Supabase (Project Settings -> API Keys)
SUPABASE_URL=https://zvexcxpweirsjgeinrtu.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Dashboard -> Connect -> "Session pooler" URI (IPv4-friendly), with your DB password filled in
SUPABASE_DB_URL=

# Anthropic (console.anthropic.com -> API Keys) — the investigation agent
ANTHROPIC_API_KEY=

# Cluster access
PROMETHEUS_URL=http://localhost:9090
KUBECONFIG_PATH=./sentinelops-agent.kubeconfig
K8S_NAMESPACE=default

# ── Freshworks: tickets, changes and approvals ──────────────────────────────

# Domain like yourcompany.freshservice.com (no https://, no custom domain — MCP needs the base)
FRESHSERVICE_DOMAIN=
# Profile settings -> API Key. Needs an agent role with API access enabled, or every call 403s.
FRESHSERVICE_API_KEY=
# Only on a multi-workspace account: the workspace to file records in. Left empty, records go
# to the default workspace, where the key's agent may not be able to read them back.
FRESHSERVICE_WORKSPACE_ID=

# ── On-call voice escalation (optional) ─────────────────────────────────────

# Vobiz: phones the on-call engineer when a fix is waiting for approval.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=
ONCALL_PHONE=
# Any long random string. Vobiz cannot authenticate to our API, so its webhooks sit under a
# secret path segment instead.
VOBIZ_WEBHOOK_SECRET=
# Public https origin of THIS backend, so Vobiz can fetch the call script (e.g. a tunnel URL).
PUBLIC_API_URL=

# Sarvam text-to-speech (Indian English) — tried first for the phone alert.
SARVAM_API_KEY=
SARVAM_SPEAKER=priya

# ElevenLabs text-to-speech — fallback if Sarvam fails or is slow. Empty key falls back again
# to the telephony provider's own voice: a nicer voice must never cost us the call.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Links written into Freshservice records ─────────────────────────────────

# Where people open SentinelOps, used for the buttons on tickets and changes.
APP_URL=http://localhost:5173
